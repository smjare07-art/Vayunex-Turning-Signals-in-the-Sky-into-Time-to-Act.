@"
# Old Git history
.git_old/

# Dependencies
node_modules/

# Environment variables
.env
.env.*
!.env.example

# Build files
dist/
dist-ssr/
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ML large prediction files
backend/ML/prediction/*.csv
backend/ML/prediction/*.parquet

# Editor files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
"@ | Set-Content .gitignore
# Large ML prediction files
ML/prediction/*.csv
ML/prediction/*.parquet
